<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="storage_rack">
    <static>true</static>
    <link name="link">
      <!-- Visual Mesh -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://storage_rack/meshes/rack.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.25 0.3 0.35 1.0</ambient>
          <diffuse>0.3 0.35 0.4 1.0</diffuse>
          <specular>0.4 0.4 0.4 1.0</specular>
        </material>
      </visual>

      <!-- Collision for Bottom Shelf (Z=0.025m) -->
      <collision name="collision_shelf_bottom">
        <pose>0 0 0.0235 0 0 0</pose>
        <geometry>
          <box>
            <size>0.24 0.12 0.003</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Collision for Middle Shelf (Z=0.145m) -->
      <collision name="collision_shelf_middle">
        <pose>0 0 0.1435 0 0 0</pose>
        <geometry>
          <box>
            <size>0.24 0.12 0.003</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Collision for Top Shelf (Z=0.265m) -->
      <collision name="collision_shelf_top">
        <pose>0 0 0.2635 0 0 0</pose>
        <geometry>
          <box>
            <size>0.24 0.12 0.003</size>
          </box>
        </geometry>
      </collision>

      <!-- Left Post Collision -->
      <collision name="collision_post_left">
        <pose>-0.116 0 0.1325 0 0 0</pose>
        <geometry>
          <box>
            <size>0.008 0.12 0.265</size>
          </box>
        </geometry>
      </collision>

      <!-- Right Post Collision -->
      <collision name="collision_post_right">
        <pose>0.116 0 0.1325 0 0 0</pose>
        <geometry>
          <box>
            <size>0.008 0.12 0.265</size>
          </box>
        </geometry>
      </collision>

      <!-- Middle Divider Collision -->
      <collision name="collision_post_mid">
        <pose>0 0 0.1325 0 0 0</pose>
        <geometry>
          <box>
            <size>0.008 0.12 0.265</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
