# Wavefront OBJ for Arena Floor (4.0m x 2.0m)
# Perfectly mapped UV coordinates for texture floor.png
mtllib floor.mtl
o arena_floor

v -2.000000 -1.000000 0.001000
v  2.000000 -1.000000 0.001000
v  2.000000  1.000000 0.001000
v -2.000000  1.000000 0.001000

vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000

vn 0.000000 0.000000 1.000000

usemtl floor_material
s 1
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
