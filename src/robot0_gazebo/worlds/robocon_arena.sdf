<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="ignition-gazebo-contact-system"
      name="ignition::gazebo::systems::Contact">
    </plugin>
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Base Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Robocon Arena Floor -->
    <include>
      <uri>model://arena_floor</uri>
      <pose>0 0 0.0025 0 0 1.5707963267948966</pose>
    </include>

    <!-- ==================== STORAGE RACKS (4 Vị trí phía bên Robot Spawn) ==================== -->
    <include>
      <uri>model://storage_rack</uri>
      <name>rack_left_top</name>
      <pose>-1.893 -0.649 0.0025 0 0 1.5707963</pose>
    </include>
    <include>
      <uri>model://storage_rack</uri>
      <name>rack_left_mid</name>
      <pose>-1.894 -0.006 0.0025 0 0 1.5707963</pose>
    </include>
    <include>
      <uri>model://storage_rack</uri>
      <name>rack_left_bot</name>
      <pose>-1.894 0.641 0.0025 0 0 1.5707963</pose>
    </include>
    <include>
      <uri>model://storage_rack</uri>
      <name>rack_bot_mid_left</name>
      <pose>-0.49 0.895 0.0025 0 0 0.0</pose>
    </include>

    <!-- ==================== PALLETS (Phía bên Robot Spawn) ==================== -->
    <!-- RACK LEFT TOP -->
    <include>
      <uri>model://pallet_aluminum</uri>
      <name>pallet_aluminum_rack_left_top_b_left</name>
      <pose>-1.893 -0.709 0.0285 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://pallet_cpu</uri>
      <name>pallet_cpu_rack_left_top_b_right</name>
      <pose>-1.893 -0.589 0.0285 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://pallet_qr</uri>
      <name>pallet_qr_rack_left_top_t_left</name>
      <pose>-1.893 -0.709 0.1485 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://pallet_chip</uri>
      <name>pallet_chip_rack_left_top_t_right</name>
      <pose>-1.893 -0.589 0.1485 0 0 1.5708</pose>
    </include>

    <!-- RACK LEFT MID -->
    <include>
      <uri>model://pallet_qr</uri>
      <name>pallet_qr_rack_left_mid_b_left</name>
      <pose>-1.894 -0.066 0.0285 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://pallet_chip</uri>
      <name>pallet_chip_rack_left_mid_b_right</name>
      <pose>-1.894 0.054 0.0285 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://pallet_aluminum</uri>
      <name>pallet_aluminum_rack_left_mid_t_left</name>
      <pose>-1.894 -0.066 0.1485 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://pallet_cpu</uri>
      <name>pallet_cpu_rack_left_mid_t_right</name>
      <pose>-1.894 0.054 0.1485 0 0 1.5708</pose>
    </include>

    <!-- RACK LEFT BOT -->
    <include>
      <uri>model://pallet_aluminum</uri>
      <name>pallet_aluminum_rack_left_bot_b_left</name>
      <pose>-1.894 0.581 0.0285 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://pallet_cpu</uri>
      <name>pallet_cpu_rack_left_bot_b_right</name>
      <pose>-1.894 0.701 0.0285 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://pallet_qr</uri>
      <name>pallet_qr_rack_left_bot_t_left</name>
      <pose>-1.894 0.581 0.1485 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://pallet_chip</uri>
      <name>pallet_chip_rack_left_bot_t_right</name>
      <pose>-1.894 0.701 0.1485 0 0 1.5708</pose>
    </include>

    <!-- RACK BOT MID LEFT -->
    <include>
      <uri>model://pallet_qr</uri>
      <name>pallet_qr_rack_bot_mid_left_b_left</name>
      <pose>-0.55 0.895 0.0285 0 0 0.0</pose>
    </include>
    <include>
      <uri>model://pallet_chip</uri>
      <name>pallet_chip_rack_bot_mid_left_b_right</name>
      <pose>-0.43 0.895 0.0285 0 0 0.0</pose>
    </include>
    <include>
      <uri>model://pallet_aluminum</uri>
      <name>pallet_aluminum_rack_bot_mid_left_t_left</name>
      <pose>-0.55 0.895 0.1485 0 0 0.0</pose>
    </include>
    <include>
      <uri>model://pallet_cpu</uri>
      <name>pallet_cpu_rack_bot_mid_left_t_right</name>
      <pose>-0.43 0.895 0.1485 0 0 0.0</pose>
    </include>
  </world>
</sdf>
