<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="ignition-gazebo-contact-system"
      name="ignition::gazebo::systems::Contact">
    </plugin>
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Balanced Environment Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Base Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.82 0.82 0.85 1</ambient>
            <diffuse>0.85 0.85 0.88 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Arena Boundary Walls -->
    <model name="arena_perimeter">
      <static>true</static>
      <link name="link">
        <!-- North Wall -->
        <visual name="wall_north_vis">
          <pose>0.15 1.6 0.075 0 0 0</pose>
          <geometry><box><size>3.8 0.04 0.15</size></box></geometry>
          <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.4 0.45 0.5 1</diffuse></material>
        </visual>
        <collision name="wall_north_col">
          <pose>0.15 1.6 0.075 0 0 0</pose>
          <geometry><box><size>3.8 0.04 0.15</size></box></geometry>
        </collision>

        <!-- South Wall -->
        <visual name="wall_south_vis">
          <pose>0.15 -1.6 0.075 0 0 0</pose>
          <geometry><box><size>3.8 0.04 0.15</size></box></geometry>
          <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.4 0.45 0.5 1</diffuse></material>
        </visual>
        <collision name="wall_south_col">
          <pose>0.15 -1.6 0.075 0 0 0</pose>
          <geometry><box><size>3.8 0.04 0.15</size></box></geometry>
        </collision>

        <!-- East Wall -->
        <visual name="wall_east_vis">
          <pose>2.0 0 0.075 0 0 0</pose>
          <geometry><box><size>0.04 3.2 0.15</size></box></geometry>
          <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.4 0.45 0.5 1</diffuse></material>
        </visual>
        <collision name="wall_east_col">
          <pose>2.0 0 0.075 0 0 0</pose>
          <geometry><box><size>0.04 3.2 0.15</size></box></geometry>
        </collision>

        <!-- West Wall -->
        <visual name="wall_west_vis">
          <pose>-1.7 0 0.075 0 0 0</pose>
          <geometry><box><size>0.04 3.2 0.15</size></box></geometry>
          <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.4 0.45 0.5 1</diffuse></material>
        </visual>
        <collision name="wall_west_col">
          <pose>-1.7 0 0.075 0 0 0</pose>
          <geometry><box><size>0.04 3.2 0.15</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ==================== START / HOME DOCKING STATION (0, 0) ==================== -->
    <include>
      <uri>model://docking_station</uri>
      <name>docking_home</name>
      <pose>0.0 0.0 0.001 0 0 0</pose>
    </include>

    <!-- ==================== STORAGE RACK (PICKUP STATION) (X=1.5, Y=0.0) ==================== -->
    <include>
      <uri>model://storage_rack</uri>
      <name>rack_pickup</name>
      <pose>1.5 0.0 0.0025 0 0 1.5707963</pose>
    </include>

    <!-- ==================== PALLETS ON STORAGE RACK ==================== -->
    <!-- Bottom Shelf (Z = 0.0285m) -->
    <!-- Left Bay (Y = -0.060) : CPU Pallet -->
    <include>
      <uri>model://pallet_cpu</uri>
      <name>pallet_cpu_bottom_left</name>
      <pose>1.5 -0.060 0.0285 0 0 1.5708</pose>
    </include>
    <!-- Right Bay (Y = +0.060) : Aluminum Pallet -->
    <include>
      <uri>model://pallet_aluminum</uri>
      <name>pallet_al_bottom_right</name>
      <pose>1.5 0.060 0.0285 0 0 1.5708</pose>
    </include>

    <!-- Top Shelf (Z = 0.1485m) -->
    <!-- Left Bay (Y = -0.060) : Chip Pallet -->
    <include>
      <uri>model://pallet_chip</uri>
      <name>pallet_chip_top_left</name>
      <pose>1.5 -0.060 0.1485 0 0 1.5708</pose>
    </include>
    <!-- Right Bay (Y = +0.060) : QR Pallet -->
    <include>
      <uri>model://pallet_qr</uri>
      <name>pallet_qr_top_right</name>
      <pose>1.5 0.060 0.1485 0 0 1.5708</pose>
    </include>

    <!-- ==================== DROP-OFF / UNLOADING STATIONS ==================== -->
    <!-- 1. Blue Drop-off Station (North / Electronics Drop-off) -->
    <include>
      <uri>model://dropoff_station_blue</uri>
      <name>dropoff_blue</name>
      <pose>0.0 1.2 0.0025 0 0 0.0</pose>
    </include>

    <!-- 2. Red Drop-off Station (South / Mechanical Drop-off) -->
    <include>
      <uri>model://dropoff_station_red</uri>
      <name>dropoff_red</name>
      <pose>0.0 -1.2 0.0025 0 0 3.14159265</pose>
    </include>

    <!-- 3. Green Drop-off Station (West / QA & Inspection Drop-off) -->
    <include>
      <uri>model://dropoff_station_green</uri>
      <name>dropoff_green</name>
      <pose>-1.2 0.0 0.0025 0 0 -1.5707963</pose>
    </include>

  </world>
</sdf>
