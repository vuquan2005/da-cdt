<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- Mecanum Wheel Macro Definition             -->
  <!-- ========================================== -->
  <xacro:macro name="mecanum_wheel" params="prefix parent mesh_type mesh_rpy joint_xyz joint_rpy axis_xyz">
    <link name="${prefix}_link">
      <inertial>
        <origin xyz="1.85e-08 0.000719 3.74e-07" rpy="0 0 0" />
        <mass value="${wheel_mass}" />
        <inertia ixx="2.275e-05" ixy="7.45e-11" ixz="8.32e-11" iyy="2.864e-05" iyz="-3.97e-11" izz="2.275e-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${mesh_rpy}" />
        <geometry>
          <mesh filename="package://robot0_description/meshes/${mesh_type}.stl" />
        </geometry>
        <material name="wheel_grey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_joint" type="continuous">
      <origin xyz="${joint_xyz}" rpy="${joint_rpy}" />
      <parent link="${parent}" />
      <child link="${prefix}_link" />
      <axis xyz="${axis_xyz}" />
      <limit effort="${wheel_effort_limit}" velocity="${wheel_velocity_limit}" />
      <dynamics damping="0.01" friction="0.01" />
    </joint>

    <gazebo reference="${prefix}_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <!-- ========================================== -->
  <!-- Wheel Instantiations                       -->
  <!-- ========================================== -->

  <!-- Front-Right Wheel -->
  <xacro:mecanum_wheel
    prefix="wheel_fr"
    parent="base_link"
    mesh_type="wheel_right"
    mesh_rpy="${PI} 0 0"
    joint_xyz="0.109279512977855 -0.162171576273727 -0.02385"
    joint_rpy="-1.5707963267949 -1.5707963267949 -1.5707963267948966"
    axis_xyz="0 -1 0" />

  <!-- Front-Left Wheel -->
  <xacro:mecanum_wheel
    prefix="wheel_fl"
    parent="base_link"
    mesh_type="wheel_left"
    mesh_rpy="0 0 0"
    joint_xyz="0.109279512977855 0.145628423726273 -0.02385"
    joint_rpy="1.5707963267949 -1.5707963267949 -1.5707963267948966"
    axis_xyz="0 1 0" />

  <!-- Rear-Right Wheel -->
  <xacro:mecanum_wheel
    prefix="wheel_rr"
    parent="base_link"
    mesh_type="wheel_left"
    mesh_rpy="${PI} 0 ${PI}"
    joint_xyz="-0.090720487022145 -0.162171576273727 -0.02385"
    joint_rpy="-1.5707963267949 -1.5707963267949 -1.5707963267948966"
    axis_xyz="0 -1 0" />

  <!-- Rear-Left Wheel -->
  <xacro:mecanum_wheel
    prefix="wheel_rl"
    parent="base_link"
    mesh_type="wheel_right"
    mesh_rpy="0 0 ${PI}"
    joint_xyz="-0.090720487022145 0.145628423726273 -0.02385"
    joint_rpy="1.5707963267949 -1.5707963267949 -1.5707963267948966"
    axis_xyz="0 1 0" />

</robot>
