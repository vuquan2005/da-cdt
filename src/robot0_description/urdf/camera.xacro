<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- Camera Sensor (Intel RealSense on base_link)-->
  <!-- ========================================== -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>

  <!-- Joint from base_link to camera_link: forward in +X, tilted down by camera_pitch -->
  <joint name="camera_joint" type="fixed">
    <origin xyz="${camera_joint_x} ${camera_joint_y} ${camera_joint_z}" rpy="0 ${camera_pitch} 0" />
    <parent link="base_link" />
    <child link="camera_link" />
  </joint>

  <!-- Optical Frame (ROS Standard: Z forward, X right, Y down) -->
  <link name="camera_optical_link" />

  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-${PI/2} 0 -${PI/2}" />
    <parent link="camera_link" />
    <child link="camera_optical_link" />
  </joint>

  <!-- Gazebo Camera Sensor Plugin -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <!-- Wide-angle FOV: ~90 deg (1.5708 rad) -->
      <camera>
        <horizontal_fov>1.5708</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
        <optical_frame_id>camera_optical_link</optical_frame_id>
      </camera>
      <always_on>1</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>/camera/image_raw</topic>
    </sensor>
    <material>Gazebo/Blue</material>
  </gazebo>

</robot>
