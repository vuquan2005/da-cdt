<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- Lift Mechanism (Prismatic Movable Arm)     -->
  <!-- ========================================== -->

  <link name="lift_arm_link">
    <inertial>
      <origin xyz="-0.01806 0.00000 -0.02565" rpy="${PI/2} 0 -${PI/2}" />
      <mass value="0.16181" />
      <inertia ixx="0.00038242" ixy="-1.38e-07" ixz="-1.26e-07" iyy="0.00045993" iyz="-0.00018047" izz="0.00040656" />
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 -${PI/2}" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/lift_arm.stl" />
      </geometry>
      <material name="orange" />
    </visual>

    <!-- Back Vertical Slider Carriage Collision -->
    <collision name="lift_arm_slider_collision">
      <origin xyz="0.008 0.000 -0.048" rpy="0 0 0" />
      <geometry>
        <box size="0.051 0.149 0.136" />
      </geometry>
    </collision>

    <!-- Left Fork Blade -->
    <collision name="lift_arm_fork_l_collision">
      <origin xyz="0.0935 0.0203 -0.1130" rpy="0 0 0" />
      <geometry>
        <box size="0.115 0.018 0.004" />
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>1.5</mu2>
          </ode>
        </friction>
      </surface>
    </collision>

    <!-- Right Fork Blade -->
    <collision name="lift_arm_fork_r_collision">
      <origin xyz="0.0935 -0.0203 -0.1130" rpy="0 0 0" />
      <geometry>
        <box size="0.115 0.018 0.004" />
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>1.5</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
  </link>

  <!-- Prismatic Joint: Moves along Z axis (UP), Centered on Y=0 -->
  <joint name="lift_arm_joint" type="prismatic">
    <origin xyz="${lift_joint_x} ${lift_joint_y} ${lift_joint_z}" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="lift_arm_link" />
    <axis xyz="0 0 1" />
    <limit lower="0.0" upper="0.20" effort="100.0" velocity="0.2" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>

</robot>
