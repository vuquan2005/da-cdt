<?xml version="1.0" encoding="utf-8"?>
<robot name="robot0" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- Base Links & Footprint (ROS Standard REP-103) -->
  <!-- ========================================== -->
  <link name="base_footprint" />

  <!-- Clean, intuitive origin: rpy="0 0 0" (REP-103: +X Forward, +Y Left, +Z Up) -->
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0.06" rpy="0 0 0" />
    <parent link="base_footprint" />
    <child link="base_link" />
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.0003708 -0.0082536 0.0149603" rpy="0 0 0" />
      <mass value="1.85" />
      <inertia ixx="0.010" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.012" />
    </inertial>

    <!-- Main Chassis Base (Rotated to +X Forward) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/base_link.stl" />
      </geometry>
      <material name="silver">
        <color rgba="0.792 0.820 0.933 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.01 -0.0083 0.03" rpy="0 0 0" />
      <geometry>
        <box size="0.28 0.24 0.06" />
      </geometry>
    </collision>

    <!-- Front-Right Motor Bracket -->
    <visual>
      <origin xyz="0.129279512977854 -0.131271576273728 -0.00376593806610101" rpy="-1.5707963267949 0 1.5707963267948934" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/motor_bracket_fr.stl" />
      </geometry>
      <material name="silver" />
    </visual>

    <!-- Front-Left Motor Bracket -->
    <visual>
      <origin xyz="0.089279512977854 0.114728423726273 -0.00376593806610101" rpy="-1.5707963267949 0 -1.5707963267948966" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/motor_bracket_fl.stl" />
      </geometry>
      <material name="silver" />
    </visual>

    <!-- Rear-Right Motor Bracket -->
    <visual>
      <origin xyz="-0.070720487022142 -0.131271576273728 -0.003765938066101" rpy="-1.5707963267949 0 1.5707963267948934" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/motor_bracket_rr.stl" />
      </geometry>
      <material name="silver" />
    </visual>

    <!-- Rear-Left Motor Bracket -->
    <visual>
      <origin xyz="-0.115720487022144 0.114728423726274 -0.00376593806610199" rpy="-1.57079632679489 0 -1.5707963267948966" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/motor_bracket_rl.stl" />
      </geometry>
      <material name="silver" />
    </visual>

    <!-- Front-Right Motor -->
    <visual>
      <origin xyz="0.109279512977855 -0.128271576273727 -0.0307659380661" rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/motor_jgb37_520_right.stl" />
      </geometry>
      <material name="silver" />
    </visual>

    <!-- Front-Left Motor -->
    <visual>
      <origin xyz="0.109279512977855 0.111728423726273 -0.0307659380661" rpy="-1.5707963267949 0 -3.141592653589793" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/motor_jgb37_520_left.stl" />
      </geometry>
      <material name="silver" />
    </visual>

    <!-- Rear-Right Motor -->
    <visual>
      <origin xyz="-0.090720487022144 -0.128271576273727 -0.0307659380661" rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/motor_jgb37_520_right.stl" />
      </geometry>
      <material name="silver" />
    </visual>

    <!-- Rear-Left Motor -->
    <visual>
      <origin xyz="-0.090720487022144 0.111728423726273 -0.0307659380661" rpy="-1.5707963267949 0 -3.141592653589793" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/motor_jgb37_520_left.stl" />
      </geometry>
      <material name="silver" />
    </visual>

    <!-- Lift Base Column -->
    <visual>
      <origin xyz="0.137279512977854 -0.008271576273727 0.00223406193389999" rpy="1.5707963267949 0 -1.5707963267948966" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/lift_base.stl" />
      </geometry>
      <material name="silver" />
    </visual>

    <!-- Lift Motor -->
    <visual>
      <origin xyz="0.119779512977854 -0.008271576273727 0.0292340619339" rpy="-1.5707963267949 0 -1.5707963267948966" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/motor_jgb37_520_right.stl" />
      </geometry>
      <material name="silver" />
    </visual>

    <!-- Lift Guide Pipe 1 -->
    <visual>
      <origin xyz="0.137279512977855 -0.065771576273727 0.00823406193389999" rpy="1.5707963267949 0 -3.2923750299165266" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/lift_pipe_1.stl" />
      </geometry>
      <material name="silver" />
    </visual>

    <!-- Lift Guide Pipe 2 -->
    <visual>
      <origin xyz="0.137279512977855 -0.008271576273727 0.046010455529876" rpy="1.5707963267949 0 -2.9908102772630566" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/lift_pipe_2.stl" />
      </geometry>
      <material name="silver" />
    </visual>

    <!-- Lift Top Cap -->
    <visual>
      <origin xyz="0.137279512977854 -0.008271576273728 0.2682340619339" rpy="1.5707963267949 0 -1.5707963267948966" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/lift_top_cap.stl" />
      </geometry>
      <material name="silver" />
    </visual>

    <!-- Lift Timing Belt -->
    <visual>
      <origin xyz="0.128279512977855 -0.008271576273728 0.2782340619339" rpy="1.5707963267949 1.5707963267949 -1.5707963267948966" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/lift_belt.stl" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0" />
      </material>
    </visual>

    <!-- Lift Top Pulley -->
    <visual>
      <origin xyz="0.128279512977855 -0.008271576273728 0.2797340619339" rpy="-1.5707963267949 -0.897413987985829 1.5707963267948934" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/lift_pulley_20t.stl" />
      </geometry>
      <material name="silver" />
    </visual>
  </link>

  <!-- ========================================== -->
  <!-- Mecanum Wheels (Continuous Joints)         -->
  <!-- ========================================== -->

  <!-- Front-Right Wheel -->
  <link name="wheel_fr_link">
    <inertial>
      <origin xyz="1.85e-08 0.000719 3.74e-07" rpy="0 0 0" />
      <mass value="0.13187" />
      <inertia ixx="2.275e-05" ixy="7.45e-11" ixz="8.32e-11" iyy="2.864e-05" iyz="-3.97e-11" izz="2.275e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="3.14159265358979 0 0" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/wheel_right.stl" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <cylinder radius="0.0487" length="0.045" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel_fr_joint" type="continuous">
    <origin xyz="0.109279512977855 -0.162171576273727 -0.02385" rpy="-1.5707963267949 -1.5707963267949 -1.5707963267948966" />
    <parent link="base_link" />
    <child link="wheel_fr_link" />
    <axis xyz="0 -1 0" />
    <limit effort="10.0" velocity="20.0" />
    <dynamics damping="0.01" friction="0.01" />
  </joint>

  <!-- Front-Left Wheel -->
  <link name="wheel_fl_link">
    <inertial>
      <origin xyz="1.85e-08 0.000719 3.74e-07" rpy="0 0 0" />
      <mass value="0.13187" />
      <inertia ixx="2.275e-05" ixy="7.45e-11" ixz="8.33e-11" iyy="2.864e-05" iyz="-3.97e-11" izz="2.275e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/wheel_left.stl" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <cylinder radius="0.0487" length="0.045" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel_fl_joint" type="continuous">
    <origin xyz="0.109279512977855 0.145628423726273 -0.02385" rpy="1.5707963267949 -1.5707963267949 -1.5707963267948966" />
    <parent link="base_link" />
    <child link="wheel_fl_link" />
    <axis xyz="0 1 0" />
    <limit effort="10.0" velocity="20.0" />
    <dynamics damping="0.01" friction="0.01" />
  </joint>

  <!-- Rear-Right Wheel -->
  <link name="wheel_rr_link">
    <inertial>
      <origin xyz="1.85e-08 0.000719 3.74e-07" rpy="0 0 0" />
      <mass value="0.13187" />
      <inertia ixx="2.275e-05" ixy="7.45e-11" ixz="8.32e-11" iyy="2.864e-05" iyz="-3.97e-11" izz="2.275e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="3.14159265358979 0 3.14159265358979" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/wheel_left.stl" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <cylinder radius="0.0487" length="0.045" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel_rr_joint" type="continuous">
    <origin xyz="-0.090720487022145 -0.162171576273727 -0.02385" rpy="-1.5707963267949 -1.5707963267949 -1.5707963267948966" />
    <parent link="base_link" />
    <child link="wheel_rr_link" />
    <axis xyz="0 -1 0" />
    <limit effort="10.0" velocity="20.0" />
    <dynamics damping="0.01" friction="0.01" />
  </joint>

  <!-- Rear-Left Wheel -->
  <link name="wheel_rl_link">
    <inertial>
      <origin xyz="1.85e-08 0.000719 3.74e-07" rpy="0 0 0" />
      <mass value="0.13187" />
      <inertia ixx="2.275e-05" ixy="7.45e-11" ixz="8.33e-11" iyy="2.864e-05" iyz="-3.97e-11" izz="2.275e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.14159265358979" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/wheel_right.stl" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <cylinder radius="0.0487" length="0.045" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel_rl_joint" type="continuous">
    <origin xyz="-0.090720487022145 0.145628423726273 -0.02385" rpy="1.5707963267949 -1.5707963267949 -1.5707963267948966" />
    <parent link="base_link" />
    <child link="wheel_rl_link" />
    <axis xyz="0 1 0" />
    <limit effort="10.0" velocity="20.0" />
    <dynamics damping="0.01" friction="0.01" />
  </joint>

  <!-- ========================================== -->
  <!-- Lift Mechanism (Prismatic Movable Arm)     -->
  <!-- ========================================== -->

  <!-- Lift Main Arm -->
  <link name="lift_arm_link">
    <inertial>
      <origin xyz="-0.0180613677899576 -3.0454656503736E-05 -0.0256536372783613" rpy="1.5707963267949 0 -1.5707963267948966" />
      <mass value="0.161814335334686" />
      <inertia ixx="0.00038242" ixy="-1.38e-07" ixz="-1.26e-07" iyy="0.00045993" iyz="-0.00018047" izz="0.00040656" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 -1.5707963267948966" />
      <geometry>
        <mesh filename="package://robot0_description/meshes/lift_arm.stl" />
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.45 0.0 1.0" />
      </material>
    </visual>
    <!-- Back Vertical Slider Carriage Collision -->
    <collision name="lift_arm_slider_collision">
      <origin xyz="0.008 0 -0.048" rpy="0 0 0" />
      <geometry>
        <box size="0.051 0.149 0.136" />
      </geometry>
    </collision>

    <!-- Left Fork Blade (Ultra-thin 4mm collision centered with STL mesh) -->
    <collision name="lift_arm_fork_l_collision">
      <origin xyz="0.0935 0.0203 -0.1130" rpy="0 0 0" />
      <geometry>
        <box size="0.115 0.018 0.004" />
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>1.5</mu2>
          </ode>
        </friction>
      </surface>
    </collision>

    <!-- Right Fork Blade (Ultra-thin 4mm collision centered with STL mesh) -->
    <collision name="lift_arm_fork_r_collision">
      <origin xyz="0.0935 -0.0203 -0.1130" rpy="0 0 0" />
      <geometry>
        <box size="0.115 0.018 0.004" />
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>1.5</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
  </link>

  <!-- Prismatic Joint: Moves cleanly along Blue Z axis (Global UP) -->
  <joint name="lift_arm_joint" type="prismatic">
    <origin xyz="0.137279512977855 -0.008271576273727 0.0435" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="lift_arm_link" />
    <axis xyz="0 0 1" />
    <limit lower="0.0" upper="0.20" effort="100.0" velocity="0.2" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>

  <!-- ========================================== -->
  <!-- Camera Sensor (Intel RealSense on base_link)-->
  <!-- ========================================== -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>

  <!-- Joint from base_link to camera_link: forward in +X, tilted down by 0.7 rad pitch -->
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.1788 -0.00767 0.272" rpy="0 0.7 0" />
    <parent link="base_link" />
    <child link="camera_link" />
  </joint>

  <!-- Optical Frame (ROS Standard: Z forward, X right, Y down) -->
  <link name="camera_optical_link" />

  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966" />
    <parent link="camera_link" />
    <child link="camera_optical_link" />
  </joint>

  <!-- ========================================== -->
  <!-- Gazebo Simulation Plugins & Properties    -->
  <!-- ========================================== -->
  <gazebo>
    <plugin
      filename="ignition-gazebo-joint-state-publisher-system"
      name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>wheel_fr_joint</joint_name>
      <joint_name>wheel_fl_joint</joint_name>
      <joint_name>wheel_rr_joint</joint_name>
      <joint_name>wheel_rl_joint</joint_name>
      <joint_name>lift_arm_joint</joint_name>
    </plugin>

    <!-- Planar / Kinematic Omnidirectional Velocity Control -->
    <plugin
      filename="robot0_planar_velocity_control"
      name="robot0_gazebo::PlanarVelocityControl">
      <topic>/cmd_vel</topic>
    </plugin>

    <!-- Ground Truth Odometry & TF Publisher -->
    <plugin
      filename="ignition-gazebo-odometry-publisher-system"
      name="ignition::gazebo::systems::OdometryPublisher">
      <odom_topic>/odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <tf_topic>/tf</tf_topic>
      <dimensions>3</dimensions>
    </plugin>

    <!-- Lift Arm Joint Position Controller Plugin (Tuned for smooth motion without force spikes) -->
    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>lift_arm_joint</joint_name>
      <topic>/model/robot0/joint/lift_arm_joint/0/cmd_pos</topic>
      <p_gain>800.0</p_gain>
      <i_gain>5.0</i_gain>
      <d_gain>30.0</d_gain>
      <i_max>5.0</i_max>
      <i_min>-5.0</i_min>
    </plugin>

    <!-- Wheel Velocity Controllers (for synchronized visual rotation) -->
    <plugin
      filename="ignition-gazebo-joint-controller-system"
      name="ignition::gazebo::systems::JointController">
      <joint_name>wheel_fl_joint</joint_name>
      <topic>/model/robot0/joint/wheel_fl_joint/cmd_vel</topic>
    </plugin>
    <plugin
      filename="ignition-gazebo-joint-controller-system"
      name="ignition::gazebo::systems::JointController">
      <joint_name>wheel_fr_joint</joint_name>
      <topic>/model/robot0/joint/wheel_fr_joint/cmd_vel</topic>
    </plugin>
    <plugin
      filename="ignition-gazebo-joint-controller-system"
      name="ignition::gazebo::systems::JointController">
      <joint_name>wheel_rl_joint</joint_name>
      <topic>/model/robot0/joint/wheel_rl_joint/cmd_vel</topic>
    </plugin>
    <plugin
      filename="ignition-gazebo-joint-controller-system"
      name="ignition::gazebo::systems::JointController">
      <joint_name>wheel_rr_joint</joint_name>
      <topic>/model/robot0/joint/wheel_rr_joint/cmd_vel</topic>
    </plugin>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <!-- Wide-angle FOV: ~90 deg (1.5708 rad) -->
      <camera>
        <horizontal_fov>1.5708</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
        <optical_frame_id>camera_optical_link</optical_frame_id>
      </camera>
      <always_on>1</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>/camera/image_raw</topic>
    </sensor>
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="lift_arm_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="wheel_fl_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="wheel_fr_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="wheel_rl_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="wheel_rr_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

</robot>
