<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- Mathematical Constants                     -->
  <!-- ========================================== -->
  <xacro:property name="PI" value="3.1415926535897931" />
  <xacro:property name="DEG_TO_RAD" value="${PI / 180.0}" />

  <!-- ========================================== -->
  <!-- Standard Materials (RViz Visual Colors)    -->
  <!-- ========================================== -->
  <material name="silver">
    <color rgba="0.792 0.820 0.933 1.0" />
  </material>

  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0" />
  </material>

  <material name="wheel_grey">
    <color rgba="0.3 0.3 0.3 1.0" />
  </material>

  <material name="orange">
    <color rgba="1.0 0.45 0.0 1.0" />
  </material>

  <!-- ========================================== -->
  <!-- Robot0 Geometric & Kinematic Properties    -->
  <!-- ========================================== -->
  <!-- Wheelbase (Front-to-Rear) = 0.200m -> lx = 0.100m -->
  <xacro:property name="wheelbase_lx" value="0.100" />
  <!-- Track Width (Left-to-Right) = 0.3078m -> ly = 0.1539m -->
  <xacro:property name="track_ly" value="0.1539" />
  <xacro:property name="wheel_z_offset" value="-0.02385" />

  <!-- Wheel Common Properties                    -->
  <xacro:property name="wheel_radius" value="0.0487" />
  <xacro:property name="wheel_length" value="0.045" />
  <xacro:property name="wheel_mass" value="0.13187" />
  <xacro:property name="wheel_effort_limit" value="10.0" />
  <xacro:property name="wheel_velocity_limit" value="20.0" />

  <!-- Lift Mechanism Kinematics -->
  <xacro:property name="lift_joint_x" value="0.128" />
  <xacro:property name="lift_joint_y" value="0.000" />
  <xacro:property name="lift_joint_z" value="0.0435" />

  <!-- Camera Sensor Kinematics -->
  <xacro:property name="camera_joint_x" value="0.1695" />
  <xacro:property name="camera_joint_y" value="0.000" />
  <xacro:property name="camera_joint_z" value="0.272" />
  <xacro:property name="camera_pitch" value="0.70" />

</robot>
